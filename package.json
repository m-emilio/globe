{
  "name": "globe",
  "description": "Display website visitor locations in real-time using Durable Objects and PartyKit.",
  "private": true,
  "cloudflare": {
    "label": "Multiplayer Globe App",
    "products": [
      "Workers",
      "Durable Objects"
    ],
    "categories": [],
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ],
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/43100bd9-8e11-4c20-cc00-3bec86253f00/public",
    "publish": true
  },
  "dependencies": {
    "cobe": "^2.0.1",
    "@noble/post-quantum": "0.7.1",
    "openpgp": "^6.3.1",
    "partyserver": "0.0.66",
    "partysocket": "^1.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.3.2",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/topojson-client": "^3.1.5",
    "@webgpu/types": "^0.1.71",
    "esbuild": "0.25.2",
    "typescript": "5.8.3",
    "wrangler": "4.107.0"
  },
  "scripts": {
    "build:client": "esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/index.tsx --bundle --splitting --format=esm --outdir=public/dist --entry-names=[name] --chunk-names=chunks/[name]-[hash] --minify --legal-comments=none --tree-shaking=true --target=es2022 --drop:console --drop:debugger && esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/pqcBoot.ts --bundle --splitting --format=esm --outdir=public/dist --entry-names=[name] --chunk-names=chunks/[name]-[hash] --minify --legal-comments=none --tree-shaking=true --target=es2022 --drop:console --drop:debugger && esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/ecdheExport.ts --bundle --format=esm --outfile=public/dist/ecdheExport.js --minify --legal-comments=none --tree-shaking=true --target=es2022 --drop:console --drop:debugger && esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/loginAsc.ts --bundle --format=esm --outfile=public/dist/loginAsc.js --minify --legal-comments=none --tree-shaking=true --target=es2022 --drop:console --drop:debugger && esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/pqcLoginBoot.ts --bundle --splitting --format=esm --outdir=public/dist --entry-names=[name] --chunk-names=chunks/[name]-[hash] --minify --legal-comments=none --tree-shaking=true --target=es2022 --drop:console --drop:debugger",
    "build:client:sri": "npm run build:client && node scripts/apply-sri.mjs",
    "build:client:dev": "esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/index.tsx --bundle --splitting --format=esm --outdir=public/dist --entry-names=[name] --chunk-names=chunks/[name]-[hash] --sourcemap --minify --legal-comments=none --tree-shaking=true --target=es2022 && esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/pqcBoot.ts --bundle --splitting --format=esm --outdir=public/dist --entry-names=[name] --chunk-names=chunks/[name]-[hash] --sourcemap --minify --legal-comments=none --tree-shaking=true --target=es2022 && esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/ecdheExport.ts --bundle --format=esm --outfile=public/dist/ecdheExport.js --sourcemap --minify --legal-comments=none --tree-shaking=true --target=es2022 && esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/loginAsc.ts --bundle --format=esm --outfile=public/dist/loginAsc.js --sourcemap --minify --legal-comments=none --tree-shaking=true --target=es2022 && esbuild --define:process.env.NODE_ENV='\"production\"' ./src/client/pqcLoginBoot.ts --bundle --splitting --format=esm --outdir=public/dist --entry-names=[name] --chunk-names=chunks/[name]-[hash] --sourcemap --minify --legal-comments=none --tree-shaking=true --target=es2022",
    "audit:deps": "npm audit --audit-level=moderate",
    "security:check": "npm run audit:deps && npm run check",
    "cf-typegen": "wrangler types ./src/server/worker-configuration.d.ts",
    "test:pqc": "node scripts/pqc-selftest.mjs",
    "check": "tsc --project src/client && tsc --project src/server && npm run test:pqc && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "setup:stripe": "node scripts/setup-stripe-billing.mjs",
    "setup:stripe:prod": "node scripts/setup-stripe-billing.mjs --webhook"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
